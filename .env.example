CONTENT_SOURCE=reddit
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=windows:trendscout:v0.1 (by /u/YOUR_USERNAME)
OUTPUT_DIR=output

# Optional read-only YouTube ingestion; no live persistence is enabled.
YOUTUBE_API_KEY=
YOUTUBE_MAX_SEARCH_PAGES=2
YOUTUBE_DETAILS_BATCH_SIZE=50
YOUTUBE_MAX_ATTEMPTS=3
YOUTUBE_CONNECT_TIMEOUT=5
YOUTUBE_READ_TIMEOUT=20
